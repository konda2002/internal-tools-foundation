// Prisma schema for the internal-tools foundation.
// SQLite does not support enums or JSON columns in Prisma, so `role` and
// `before`/`after` are stored as strings. The TypeScript side narrows them:
// see `Role` in lib/auth.ts and `AuditChange` in lib/audit.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// "ANALYST" | "OPS_LEAD"
  role         String
  createdAt    DateTime @default(now()) @map("created_at")

  auditEntries   AuditLog[]
  refundsDecided Refund[]
  kycDecided     KycCase[]

  @@map("users")
}

/// Append-only. The migration adds SQLite triggers that abort any UPDATE or
/// DELETE on this table; the only write path is lib/audit.ts#writeAudit.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  /// Role the actor held when acting ("ANALYST" | "OPS_LEAD"); roles change, history must not
  actorRole  String   @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  /// JSON snapshot of the entity before the change (null for creates)
  before     String?
  /// JSON snapshot of the entity after the change (null for deletes)
  after      String?
  /// Matches the x-request-id response header, for tracing a change to a request/log line
  requestId  String?  @map("request_id")
  /// Actor-supplied justification, when the tool asks for one
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([requestId])
  @@map("audit_log")
}

/// Trivial entity that exists only so app/api/_template/route.ts has
/// something to operate on. Real tools add their own models.
model Note {
  id     String @id @default(cuid())
  body   String
  /// "OPEN" | "RESOLVED" | "ARCHIVED"
  status String @default("OPEN")

  @@map("notes")
}

model Refund {
  id          String    @id @default(cuid())
  customerId  String    @map("customer_id")
  amountCents Int       @map("amount_cents")
  currency    String    @default("USD")
  /// The customer's stated reason for the refund
  reason      String
  /// "PENDING" | "APPROVED" | "REJECTED"
  status      String    @default("PENDING")
  decidedById String?   @map("decided_by_id")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  decidedBy User? @relation(fields: [decidedById], references: [id])

  @@index([status, createdAt])
  @@map("refunds")
}

model KycCase {
  id           String    @id @default(cuid())
  customerId   String    @map("customer_id")
  /// "PASSPORT" | "DRIVERS_LICENSE" | "NATIONAL_ID"
  documentType String    @map("document_type")
  /// 0-100 from the KYC vendor; 70+ cannot be verified
  riskScore    Int       @map("risk_score")
  /// Analyst notes from the KYC vendor
  notes        String?
  /// "PENDING" | "VERIFIED" | "ESCALATED" | "REJECTED"
  status       String    @default("PENDING")
  decidedById  String?   @map("decided_by_id")
  decidedAt    DateTime? @map("decided_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  decidedBy User? @relation(fields: [decidedById], references: [id])

  @@index([status, createdAt])
  @@map("kyc_cases")
}
